<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationIcon>../Skua.Shared.Avalonia/Assets/SkuaIcon.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AssemblyName>SkuaZZ</AssemblyName>
        <AssemblyTitle>SkuaZZ</AssemblyTitle>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyMetadata Include="Skua.ClientId" Value="SkuaZZAvalonia" />
    </ItemGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <UseWindowsForms>true</UseWindowsForms>
        <DefineConstants>$(DefineConstants);IS_WINDOWS</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Velopack" />
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />

        <PackageReference Include="Material.Avalonia" />
        <PackageReference Include="Material.Icons" />
        <PackageReference Include="Material.Icons.Avalonia" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Skua.Core\Skua.Core.csproj" />
        <ProjectReference Include="..\Skua.Core.Interfaces\Skua.Core.Interfaces.csproj" />
        <ProjectReference Include="..\Skua.Core.Models\Skua.Core.Models.csproj" />
        <ProjectReference Include="..\Skua.Shared.Avalonia\Skua.Shared.Avalonia.csproj" />
    </ItemGroup>
    
    <ItemGroup>
        <Content Include="QuestData.json">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <EmbeddedResource Include="ClassEnhancePresets.json" LogicalName="ClassEnhancePresets.json" />
        <EmbeddedResource Include="UltraWiki.json" LogicalName="UltraWiki.json" />
        <Content Include="AdvancedSkills.json">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Skua.AS3\skua\bin\skua.swf" Link="skua.swf" Condition="Exists('..\Skua.AS3\skua\bin\skua.swf')">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!--
      The game player: the Skua build of Mugetsu (GPL-3.0, source at https://github.com/retr0gr4d3/skua-mugetsu).
      It is downloaded once into player\<version>\ at the repository root and copied to the output's player\ folder.
      To try a local build of the player instead, pass -p:SkuaPlayerLocal=<folder with Mugetsu.exe>.
    -->
    <PropertyGroup>
        <SkuaPlayerVersion>1.6.0-skua.1</SkuaPlayerVersion>
        <SkuaPlayerZip>Mugetsu-$(SkuaPlayerVersion)-windows.zip</SkuaPlayerZip>
        <SkuaPlayerUrl>https://github.com/retr0gr4d3/skua-mugetsu/releases/download/v$(SkuaPlayerVersion)/$(SkuaPlayerZip)</SkuaPlayerUrl>
        <SkuaPlayerCache>$(MSBuildThisFileDirectory)..\player\$(SkuaPlayerVersion)</SkuaPlayerCache>
        <SkuaPlayerDir Condition="'$(SkuaPlayerLocal)' != ''">$(SkuaPlayerLocal)</SkuaPlayerDir>
        <SkuaPlayerDir Condition="'$(SkuaPlayerLocal)' == ''">$(SkuaPlayerCache)\Mugetsu</SkuaPlayerDir>
    </PropertyGroup>

    <Target Name="DownloadSkuaPlayer" Condition="'$(SkuaPlayerLocal)' == '' And !Exists('$(SkuaPlayerDir)\Mugetsu.exe')">
        <DownloadFile SourceUrl="$(SkuaPlayerUrl)" DestinationFolder="$(SkuaPlayerCache)" />
        <Unzip SourceFiles="$(SkuaPlayerCache)\$(SkuaPlayerZip)" DestinationFolder="$(SkuaPlayerCache)" />
    </Target>

    <Target Name="AddSkuaPlayer" BeforeTargets="AssignTargetPaths" DependsOnTargets="DownloadSkuaPlayer">
        <ItemGroup>
            <_SkuaPlayerFile Include="$(SkuaPlayerDir)\**" />
            <None Include="@(_SkuaPlayerFile)" Link="player\%(_SkuaPlayerFile.RecursiveDir)%(_SkuaPlayerFile.Filename)%(_SkuaPlayerFile.Extension)" CopyToOutputDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <None Update="app.manifest">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
